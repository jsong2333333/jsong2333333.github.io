---
layout: default
---
{% comment %}
  A profile page with the same shape as the about page: a floated portrait with
  optional side notes, free-form intro text, and an optional scrollable gallery
  of images and videos driven by the `gallery` list in the page front matter.
{% endcomment %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.subtitle %}
      <p class="post-description">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.gallery and page.gallery.size > 0 %}
      <h2>{{ page.gallery_title | default: 'gallery' }}</h2>
      {% if page.gallery_description %}
        <p class="gallery-description">{{ page.gallery_description }}</p>
      {% endif %}
      <div class="bio-gallery">
        {% for item in page.gallery %}
          {% assign ext = item.path | split: '.' | last | downcase %}
          <div class="bio-gallery-item">
            {% if ext == 'mp4' or ext == 'webm' or ext == 'ogg' %}
              {%
                include video.liquid path=item.path class="img-fluid rounded z-depth-1" controls=true
                muted=true loop=true caption=item.caption
              %}
            {% else %}
              {%
                include figure.liquid loading="lazy" path=item.path class="img-fluid rounded z-depth-1"
                alt=item.caption caption=item.caption zoomable=true
              %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </article>
</div>

<style>
  /* Diamond runs alongside the pointer on her own page. 32px is the size every
     browser accepts; the hotspot sits on her nose. */
  body {
    cursor:
      url("{{ '/assets/cursors/running-kitty.png' | relative_url }}") 27 13,
      auto;
  }

  /* The portrait is a tall phone photo. Crop it to a shorter oval and frame the
     subject, so it sits beside the intro text instead of running past it. */
  .profile img {
    aspect-ratio: 1 / 1.1;
    object-fit: cover;
    object-position: center 65%;
    display: block;
  }

  @media (min-width: 576px) {
    .profile {
      width: 28%;
    }
  }

  .profile .more-info {
    text-align: center;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .bio-gallery {
    max-height: 70vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.75rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .bio-gallery-item figure {
    margin-bottom: 0;
  }

  .bio-gallery-item img,
  .bio-gallery-item video {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .bio-gallery-item figcaption {
    font-size: 0.8rem;
    padding-top: 0.35rem;
  }

  @media (max-width: 576px) {
    .bio-gallery {
      max-height: 60vh;
      grid-template-columns: 1fr;
    }
  }
</style>
